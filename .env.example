# ==============================================================================
# PAGE INTERNATIONAL B2B PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace all placeholder values before starting.
# Never commit .env or real credentials to version control.
# ==============================================================================

# Application Runtime Environment
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Nitro Server Preset:
# - Local Node.js / Docker VPS: "node-server"
# - Cloudflare Workers / Pages: "cloudflare-module"
# - Vercel: "vercel"
NITRO_PRESET=node-server

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL 16)
# ==============================================================================
# Leave DATABASE_URL empty during local development to use embedded PGlite WASM
# (.data/postgres). In production or Docker, provide a full PostgreSQL connection URL.
# Example: postgresql://postgres_user:strong_password@localhost:5432/page_international
DATABASE_URL=

# PostgreSQL Container Credentials (Used by docker-compose)
POSTGRES_USER=page_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_24_chars
POSTGRES_DB=page_international
POSTGRES_PORT=5432

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Secret key used for signing JWT session tokens and cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_openssl_generated_random_64_byte_secret

# Initial Super-Administrator Bootstrap Credentials:
# Used only during initial db:seed to create the first admin user.
# If omitted, db:seed generates a secure random password and prints it to the console once.
ADMIN_EMAIL=admin@pageinternational.com
ADMIN_PASSWORD=

# Session Expiration in days (defaults to 14 days)
SESSION_MAX_AGE_DAYS=14

# ==============================================================================
# TRANSACTIONAL EMAIL (Resend API or SMTP)
# ==============================================================================
# Supported providers: "auto" (Resend -> SMTP -> Console), "resend", "smtp", "console"
MAIL_PROVIDER=auto

# Resend API (recommended for OTP verification & transactional alerts):
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address:
# - Testing before domain verification: use "PAGE International <onboarding@resend.dev>"
#   (Resend delivers onboarding@resend.dev emails only to your Resend account email)
# - Production: verify your domain in Resend, then use e.g. "PAGE International <no-reply@pageinternational.com>"
EMAIL_FROM="PAGE International <onboarding@resend.dev>"
MAIL_ADMIN_NOTIFICATION=sales@pageinternational.com

# Optional SMTP fallback (if using Zoho, Gmail App Password, Postmark, AWS SES, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# MEDIA & ASSET STORAGE
# ==============================================================================
# Driver options: "local" (persisted in public/uploads or docker volume) or "s3"
STORAGE_DRIVER=local

# Required if STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ==============================================================================
# MONITORING & ERROR TRACKING (Optional)
# ==============================================================================
SENTRY_DSN=
