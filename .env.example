# ==============================================================================
# PAGE INTERNATIONAL B2B PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace all placeholder values before starting.
# Never commit .env or real credentials to version control.
# ==============================================================================

# Application Runtime Environment
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Production VPS Domain & HTTPS Certificate Email (Used by Caddy 2 in docker-compose.yml)
# Leave APP_DOMAIN as :80 for local HTTP testing; set to e.g. pageinternational.com on a VPS.
APP_DOMAIN=:80
ACME_EMAIL=admin@pageintl.com

# Nitro Server Preset:
# - Local Node.js / Docker VPS: "node-server"
# - Cloudflare Workers / Pages: "cloudflare-module"
# - Vercel: "vercel"
NITRO_PRESET=node-server

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL 16)
# ==============================================================================
# Leave DATABASE_URL empty during local development to use embedded PGlite WASM
# (.data/postgres). In production or Docker, provide a full PostgreSQL connection URL.
# Example: postgresql://postgres_user:strong_password@localhost:5432/page_international
DATABASE_URL=

# PostgreSQL Container Credentials (Used by docker-compose)
POSTGRES_USER=page_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_24_chars
POSTGRES_DB=page_international
POSTGRES_PORT=5432

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Secret key used for signing JWT session tokens and cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_openssl_generated_random_64_byte_secret

# Initial Super-Administrator Bootstrap Credentials:
# Used during initial db:seed to create the first admin user.
# Set a strong password in production before first boot!
ADMIN_EMAIL=admin@pageintl.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Session Expiration in days (defaults to 14 days)
SESSION_MAX_AGE_DAYS=14

# ==============================================================================
# TRANSACTIONAL EMAIL (SMTP or Resend API)
# ==============================================================================
# Supported providers:
# - "smtp": Free Gmail App Password, Zoho Mail, Brevo, AWS SES, or custom SMTP
# - "resend": Resend HTTP REST API
# - "auto": Verified Resend domain -> Usable SMTP -> Resend Sandbox -> Console
# - "console": Log emails cleanly to server stdout only (local dev)
MAIL_PROVIDER=auto

# Gmail SMTP Setup (free, sends OTPs to any buyer without buying a custom domain):
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-char App Password: https://myaccount.google.com/apppasswords
# 3. Set MAIL_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend API (alternative when using a verified custom domain):
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address:
# - With Gmail SMTP: leave blank (auto-uses SMTP_USER) or set "PAGE International <your@gmail.com>"
# - With Resend sandbox: use "PAGE International <onboarding@resend.dev>" (owner email only)
# - Production custom domain: e.g. "PAGE International <no-reply@pageinternational.com>"
EMAIL_FROM=""
MAIL_ADMIN_NOTIFICATION=sales@pageinternational.com

# Quotation verification mode:
# - "auto" (default): requires Email OTP only when real external email delivery is configured
#   (ready SMTP credentials or Resend with a verified custom sender domain)
# - "true": always require 6-digit Email OTP before saving quotation requests
# - "false": always accept direct RFQ submissions without OTP
REQUIRE_QUOTE_EMAIL_OTP=auto

# ==============================================================================
# MEDIA & ASSET STORAGE
# ==============================================================================
# Driver options:
# - "local" (persisted on server disk public/uploads or Docker volume)
# - "database" (mirrors uploads <= 15 MB into PostgreSQL media.storage_data so
#               assets survive ephemeral restarts on Render Free Tier)
# - "s3" (external S3/R2 bucket configuration)
STORAGE_DRIVER=local

# Optional Database Connection Tuning (auto-detected for Neon, Supabase, Render):
# DB_POOL_MAX=5
# DB_SSL=require
# DB_PREPARE=false
# TRUST_PROXY=true

# Required if STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ==============================================================================
# MONITORING & ERROR TRACKING (Optional)
# ==============================================================================
SENTRY_DSN=
